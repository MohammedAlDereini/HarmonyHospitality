<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="harmony" value="https://nuget.pkg.github.com/MohammedAlDereini/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
    <packageSource key="harmony"><package pattern="Harmony.*" /></packageSource>
  </packageSourceMapping>
</configuration>