@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Choose your password";
}

<h1>Choose your own password</h1>
<p class="lead">The password you signed in with was set by someone else. Replace it before continuing.</p>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="CurrentPassword">Current password</label>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus required />
    <label asp-for="NewPassword">New password</label>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
    <label asp-for="ConfirmPassword">Repeat it</label>
    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
    <p class="note">At least 12 characters with one symbol, like - or ! (a space counts). A few words make a strong password.</p>
    @if (Model.Error is not null)
    {
        <p class="error" role="alert">@Model.Error</p>
    }
    <button type="submit" data-busy="Saving…">Save and continue</button>
</form>
