@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>
<p class="lead">Your work e-mail and password.</p>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="Email">E-mail</label>
    <input asp-for="Email" type="email" autocomplete="username" autofocus required />
    <label asp-for="Password">Password</label>
    <input asp-for="Password" type="password" autocomplete="current-password" required />
    @if (Model.Error is not null)
    {
        <p class="error" role="alert">@Model.Error</p>
    }
    <button type="submit">Sign in</button>
</form>
<p class="links"><a href="@Model.ForgotPasswordUrl">Forgot your password?</a></p>
