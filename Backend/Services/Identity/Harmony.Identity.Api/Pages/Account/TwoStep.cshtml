@page
@model TwoStepModel
@{
    ViewData["Title"] = "Second step";
}

<h1>Second step</h1>
<p class="lead">@(Model.Recovery ? "Enter one of your recovery codes." : "Enter the 6-digit code from your authenticator app.")</p>
<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <input type="hidden" asp-for="Recovery" />
    <label asp-for="Code">@(Model.Recovery ? "Recovery code" : "Code")</label>
    <input asp-for="Code" autocomplete="one-time-code" inputmode="@(Model.Recovery ? "text" : "numeric")" autofocus required />
    @if (Model.Error is not null)
    {
        <p class="error" role="alert">@Model.Error</p>
    }
    <button type="submit">Continue</button>
</form>
<p class="links">
    <a asp-page="TwoStep" asp-route-returnUrl="@Model.ReturnUrl" asp-route-recovery="@(!Model.Recovery)">@(Model.Recovery ? "Use the authenticator app instead" : "Use a recovery code instead")</a>
</p>
