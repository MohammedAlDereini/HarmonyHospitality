<!DOCTYPE html>
@using Harmony.Identity.Api.Pages.Account
@* The sign-in family. The web app's pages: one card in the middle, the same look as the web app. The console's pages
   (a platform-only client asked): the console frame, a brand panel beside the card (platform console design, C12).
   One script of ours (one send per page), allowed only by this response's nonce; no inline script anywhere. *@
@{
    var frame = ConsoleFrame.Of(ViewData);
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Harmony</title>
    <link rel="stylesheet" href="~/css/sign-in.css" asp-append-version="true" />
    <script src="~/js/sign-in.js" asp-append-version="true" nonce="@SignInPageHeadersAttribute.Nonce(Context)" defer></script>
</head>
<body class="@(frame is null ? "" : "console")">
    @if (frame is null)
    {
        <main class="centered">
            <div class="card">
                <div class="brand">
                    <partial name="_Lockup" />
                </div>
                @RenderBody()
            </div>
        </main>
    }
    else
    {
        <main class="split">
            <aside class="panel">
                <div class="lockup-row">
                    <partial name="_Lockup" />
                    <span class="divider" aria-hidden="true"></span>
                    <span class="product">Console</span>
                </div>
                <div class="grow" aria-hidden="true"></div>
                <div class="door" aria-hidden="true">
                    <img src="~/img/console/lit-door.svg" alt="" width="100" height="120" />
                </div>
                <div class="statement">
                    <h2>Platform console</h2>
                    <p>For Harmony platform staff: tenants, hotels, subscriptions, reference data, health. Hotel teams use the Harmony web app.</p>
                </div>
                <div class="grow" aria-hidden="true"></div>
                <ul class="status">
                    <li>
                        <svg class="ok" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14A6 6 0 1 0 8 2a6 6 0 0 0 0 12Z" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" stroke-linejoin="round" /><path d="m5.33 8.33 1.8 1.8L10.67 6.4" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        <span>All sign-in services are running · @frame.NowUtc.ToString("HH:mm") UTC</span>
                    </li>
                    <li>
                        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 2l5 2v3.67C13 10.67 10.87 13.07 8 14c-2.87-.93-5-3.33-5-6.33V4l5-2Z" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" stroke-linejoin="round" /><path d="m5.87 8 1.46 1.47 2.94-2.94" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        @if (frame.TwoStepExceptions == 0)
                        {
                            <span>Two-step is required for every platform person</span>
                        }
                        else
                        {
                            <span>Two-step is required; @frame.TwoStepExceptions on the platform's exception list</span>
                        }
                    </li>
                    @if (frame.PlatformContact.Length > 0)
                    {
                        <li>
                            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14A6 6 0 1 0 8 2a6 6 0 0 0 0 12Z" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" stroke-linejoin="round" /><path d="M6.4 6.27a1.67 1.67 0 1 1 2.27 1.6c-.4.2-.67.6-.67 1.07v.4" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" stroke-linejoin="round" /><path d="M8 11.33h.01" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" /></svg>
                            <span>@frame.PlatformContact</span>
                        </li>
                    }
                </ul>
                <p class="fine">
                    Identity @frame.Version
                    @if (frame.PrivacyUrl.Length > 0)
                    {
                        <text> · </text><a href="@frame.PrivacyUrl">Privacy</a>
                    }
                    @if (frame.TermsUrl.Length > 0)
                    {
                        <text> · </text><a href="@frame.TermsUrl">Terms of use</a>
                    }
                </p>
                <img class="arcade" src="~/img/console/arcade-band.svg" alt="" aria-hidden="true" />
            </aside>
            <section class="stage">
                <div class="stage-top">
                    @if (frame.HelpUrl.Length > 0)
                    {
                        <a class="ghost" href="@frame.HelpUrl">
                            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14A6 6 0 1 0 8 2a6 6 0 0 0 0 12Z" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" stroke-linejoin="round" /><path d="M6.4 6.27a1.67 1.67 0 1 1 2.27 1.6c-.4.2-.67.6-.67 1.07v.4" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" stroke-linejoin="round" /><path d="M8 11.33h.01" stroke="currentColor" stroke-width="1.46" stroke-linecap="round" /></svg>
                            Help
                        </a>
                    }
                </div>
                <div class="stage-centre">
                    <div class="card console-card">
                        @RenderBody()
                    </div>
                </div>
                <p class="stage-foot">Signing in on a shared machine? Sign out when you leave; sessions end after 12 hours regardless.</p>
            </section>
        </main>
    }
</body>
</html>
