<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Harmony.Core.BuildingBlocks" Version="*" />
		<PackageReference Include="Harmony.Core.Cache" Version="*" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.13" />
		<PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
		<!-- Pulled in transitively at a vulnerable version (GHSA-846f-f764-76mx); named here to take the patched one. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="applicationSettings.json" CopyToOutputDirectory="PreserveNewest" />
		<Content Update="applicationSettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
		<!-- The console host's settings: one build, two run folders; these files are deployed by hand, never with the build. -->
		<Content Remove="Hosts/**" />
		<None Include="Hosts/**" />
	</ItemGroup>

</Project>
