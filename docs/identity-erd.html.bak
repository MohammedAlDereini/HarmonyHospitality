    uniqueidentifier Id PK
  }
  StepUpAuthorizations {
    uniqueidentifier Id PK
  }

  UserAccounts ||--o{ MakerCheckerRequests : "raised by"
  StepUpAuthorizations ||--o{ MakerCheckerRequests : "proved by"
  MakerCheckerRequests ||--o{ MakerCheckerExecutions : "executed as"
  MakerCheckerRequests ||--o{ MakerCheckerExpectedVersions : "guarded by"
  MakerCheckerRequests ||--o{ QuarantineReleases : "releases"
  MakerCheckerExecutions ||--o{ MakerCheckerExecutionItems : "changed"
  UserAccounts ||--o{ MakerCheckerExecutionItems : "affected in"
  UserAccounts ||--o{ MakerCheckerExecutions : "approved by"
