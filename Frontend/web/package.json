{
  "name": "harmony-frontend",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:translations": "node tools/check-translations.mjs",
    "check:architecture": "node tools/check-architecture.mjs .",
    "check:styles": "node tools/check-styles.mjs",
    "check": "eslint . && prettier --check . && node tools/check-translations.mjs && node tools/check-architecture.mjs . && node tools/check-styles.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/localize": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
